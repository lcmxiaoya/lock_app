/* ============================================
   智能锁小程序 - 全局样式
   参考通通锁 app 设计风格
   ============================================ */

/* 全局变量 */
page {
  --primary-color: #4A90E2;
  --primary-dark: #3A7BD5;
  --primary-light: #6BA5E7;
  --success-color: #4CAF50;
  --warning-color: #FF9800;
  --danger-color: #F44336;
  --text-primary: #1A1A1A;
  --text-secondary: #666666;
  --text-hint: #999999;
  --bg-color: #F5F7FA;
  --card-bg: #FFFFFF;
  --border-color: #EEEEEE;
  --shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);

  background-color: var(--bg-color);
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', 'Microsoft YaHei', sans-serif;
  color: var(--text-primary);
  font-size: 28rpx;
  line-height: 1.5;
}

/* 容器 */
.container {
  padding: 30rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

/* ============================================
   表单样式
   ============================================ */
.form-group {
  margin-bottom: 24rpx;
}

.form-label {
  font-size: 28rpx;
  color: var(--text-secondary);
  margin-bottom: 16rpx;
  display: block;
}

.form-input {
  width: 100%;
  height: 96rpx;
  background-color: var(--card-bg);
  border: 2rpx solid var(--border-color);
  border-radius: 16rpx;
  padding: 0 30rpx;
  font-size: 30rpx;
  color: var(--text-primary);
  box-sizing: border-box;
  transition: border-color 0.3s;
}

.form-input:focus {
  border-color: var(--primary-color);
}

.form-input-placeholder {
  color: var(--text-hint);
}

/* ============================================
   按钮样式
   ============================================ */
.btn {
  width: 100%;
  height: 96rpx;
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  transition: opacity 0.3s;
}

.btn::after {
  border: none;
}

.btn-primary {
  background: linear-gradient(135deg, var(--primary-color) 0%, var(--primary-dark) 100%);
  color: #FFFFFF;
  box-shadow: 0 8rpx 24rpx rgba(74, 144, 226, 0.35);
}

.btn-primary:active {
  opacity: 0.85;
}

.btn-secondary {
  background-color: var(--card-bg);
  color: var(--primary-color);
  border: 2rpx solid var(--primary-color);
}

.btn-danger {
  background-color: var(--danger-color);
  color: #FFFFFF;
}

.btn-ghost {
  background-color: transparent;
  color: var(--primary-color);
}

.btn-small {
  height: 64rpx;
  padding: 0 32rpx;
  font-size: 26rpx;
  border-radius: 32rpx;
  width: auto;
}

.btn-disabled {
  background-color: #CCCCCC;
  color: #FFFFFF;
  box-shadow: none;
}

/* ============================================
   卡片样式
   ============================================ */
.card {
  background-color: var(--card-bg);
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow);
}

/* ============================================
   标签样式
   ============================================ */
.tag {
  display: inline-flex;
  align-items: center;
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  font-weight: 500;
}

.tag-owner {
  background-color: rgba(255, 152, 0, 0.12);
  color: var(--warning-color);
}

.tag-common {
  background-color: rgba(76, 175, 80, 0.12);
  color: var(--success-color);
}

.tag-type {
  background-color: rgba(74, 144, 226, 0.12);
  color: var(--primary-color);
}

.tag-danger {
  background-color: rgba(244, 67, 54, 0.12);
  color: var(--danger-color);
}

/* ============================================
   文字样式
   ============================================ */
.text-primary { color: var(--text-primary); }
.text-secondary { color: var(--text-secondary); }
.text-hint { color: var(--text-hint); }
.text-blue { color: var(--primary-color); }
.text-success { color: var(--success-color); }
.text-warning { color: var(--warning-color); }
.text-danger { color: var(--danger-color); }
.text-bold { font-weight: 600; }
.text-center { text-align: center; }

/* ============================================
   间距工具类
   ============================================ */
.mt-10 { margin-top: 10rpx; }
.mt-20 { margin-top: 20rpx; }
.mt-30 { margin-top: 30rpx; }
.mt-40 { margin-top: 40rpx; }
.mb-10 { margin-bottom: 10rpx; }
.mb-20 { margin-bottom: 20rpx; }
.mb-30 { margin-bottom: 30rpx; }
.mb-40 { margin-bottom: 40rpx; }
.p-20 { padding: 20rpx; }
.p-30 { padding: 30rpx; }

/* ============================================
   Flex 布局
   ============================================ */
.flex { display: flex; }
.flex-center { display: flex; align-items: center; justify-content: center; }
.flex-between { display: flex; align-items: center; justify-content: space-between; }
.flex-column { display: flex; flex-direction: column; }
.flex-1 { flex: 1; }

/* ============================================
   分割线
   ============================================ */
.divider {
  height: 1rpx;
  background-color: var(--border-color);
  margin: 24rpx 0;
}

/* ============================================
   空状态
   ============================================ */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 160rpx 60rpx;
}

.empty-icon {
  width: 160rpx;
  height: 160rpx;
  background-color: rgba(74, 144, 226, 0.08);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
}

.empty-icon-inner {
  width: 80rpx;
  height: 80rpx;
  border: 6rpx solid var(--primary-light);
  border-radius: 50%;
  position: relative;
}

.empty-icon-inner::after {
  content: '';
  position: absolute;
  width: 30rpx;
  height: 6rpx;
  background-color: var(--primary-light);
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%) rotate(45deg);
}

.empty-text {
  font-size: 30rpx;
  color: var(--text-secondary);
  margin-bottom: 12rpx;
}

.empty-hint {
  font-size: 26rpx;
  color: var(--text-hint);
}

/* ============================================
   加载状态
   ============================================ */
.loading-more {
  text-align: center;
  padding: 30rpx;
  color: var(--text-hint);
  font-size: 26rpx;
}

/* ============================================
   浮动按钮
   ============================================ */
.fab {
  position: fixed;
  right: 40rpx;
  bottom: 200rpx;
  width: 100rpx;
  height: 100rpx;
  background: linear-gradient(135deg, var(--primary-color) 0%, var(--primary-dark) 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 32rpx rgba(74, 144, 226, 0.4);
  z-index: 100;
}

.fab-icon {
  width: 40rpx;
  height: 40rpx;
  position: relative;
}

.fab-icon::before,
.fab-icon::after {
  content: '';
  position: absolute;
  background-color: #FFFFFF;
  border-radius: 4rpx;
}

.fab-icon::before {
  width: 40rpx;
  height: 6rpx;
  top: 50%;
  left: 0;
  transform: translateY(-50%);
}

.fab-icon::after {
  width: 6rpx;
  height: 40rpx;
  left: 50%;
  top: 0;
  transform: translateX(-50%);
}

/* ============================================
   页面头部
   ============================================ */
.page-header {
  background: linear-gradient(135deg, var(--primary-color) 0%, var(--primary-dark) 100%);
  padding: 40rpx 30rpx 60rpx;
  color: #FFFFFF;
  margin: -30rpx -30rpx 30rpx;
  border-radius: 0 0 32rpx 32rpx;
}

.page-header-title {
  font-size: 40rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.page-header-subtitle {
  font-size: 26rpx;
  opacity: 0.85;
}

/* ============================================
   列表项
   ============================================ */
.list-item {
  display: flex;
  align-items: center;
  padding: 32rpx;
  background-color: var(--card-bg);
  border-bottom: 1rpx solid var(--border-color);
}

.list-item:last-child {
  border-bottom: none;
}

.list-item-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.list-item-content {
  flex: 1;
  min-width: 0;
}

.list-item-title {
  font-size: 30rpx;
  color: var(--text-primary);
  font-weight: 500;
  margin-bottom: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.list-item-desc {
  font-size: 24rpx;
  color: var(--text-hint);
}

.list-item-arrow {
  width: 16rpx;
  height: 16rpx;
  border-top: 4rpx solid var(--text-hint);
  border-right: 4rpx solid var(--text-hint);
  transform: rotate(45deg);
  flex-shrink: 0;
  margin-left: 16rpx;
}

/* ============================================
   图标组件（纯CSS）
   ============================================ */
.icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

.icon-lock {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid currentColor;
  border-radius: 8rpx;
  position: relative;
}

.icon-lock::after {
  content: '';
  position: absolute;
  width: 20rpx;
  height: 16rpx;
  border: 4rpx solid currentColor;
  border-bottom: none;
  border-radius: 12rpx 12rpx 0 0;
  top: -18rpx;
  left: 50%;
  transform: translateX(-50%);
}

.icon-key {
  width: 40rpx;
  height: 40rpx;
  border: 4rpx solid currentColor;
  border-radius: 50%;
  position: relative;
}

.icon-key::after {
  content: '';
  position: absolute;
  width: 4rpx;
  height: 20rpx;
  background-color: currentColor;
  bottom: -20rpx;
  right: -4rpx;
  transform: rotate(45deg);
}

.icon-password {
  width: 40rpx;
  height: 48rpx;
  border: 4rpx solid currentColor;
  border-radius: 8rpx;
  position: relative;
}

.icon-password::before {
  content: '••••';
  position: absolute;
  font-size: 16rpx;
  letter-spacing: 2rpx;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
}

.icon-record {
  width: 40rpx;
  height: 48rpx;
  border: 4rpx solid currentColor;
  border-radius: 8rpx;
  position: relative;
}

.icon-record::before {
  content: '';
  position: absolute;
  width: 24rpx;
  height: 4rpx;
  background-color: currentColor;
  top: 12rpx;
  left: 50%;
  transform: translateX(-50%);
}

.icon-record::after {
  content: '';
  position: absolute;
  width: 24rpx;
  height: 4rpx;
  background-color: currentColor;
  top: 24rpx;
  left: 50%;
  transform: translateX(-50%);
}

.icon-user {
  width: 40rpx;
  height: 40rpx;
  border: 4rpx solid currentColor;
  border-radius: 50%;
  position: relative;
}

.icon-user::after {
  content: '';
  position: absolute;
  width: 24rpx;
  height: 16rpx;
  border: 4rpx solid currentColor;
  border-top: none;
  border-radius: 0 0 16rpx 16rpx;
  bottom: -18rpx;
  left: 50%;
  transform: translateX(-50%);
}

.icon-add {
  position: relative;
}

.icon-add::before,
.icon-add::after {
  content: '';
  position: absolute;
  background-color: currentColor;
  border-radius: 2rpx;
  top: 50%;
  left: 50%;
}

.icon-add::before {
  width: 100%;
  height: 4rpx;
  transform: translate(-50%, -50%);
}

.icon-add::after {
  width: 4rpx;
  height: 100%;
  transform: translate(-50%, -50%);
}

.icon-search {
  width: 36rpx;
  height: 36rpx;
  border: 4rpx solid currentColor;
  border-radius: 50%;
  position: relative;
}

.icon-search::after {
  content: '';
  position: absolute;
  width: 12rpx;
  height: 4rpx;
  background-color: currentColor;
  bottom: -8rpx;
  right: -8rpx;
  transform: rotate(45deg);
}

.icon-battery {
  width: 48rpx;
  height: 24rpx;
  border: 3rpx solid currentColor;
  border-radius: 4rpx;
  position: relative;
}

.icon-battery::before {
  content: '';
  position: absolute;
  width: 6rpx;
  height: 12rpx;
  background-color: currentColor;
  right: -9rpx;
  top: 50%;
  transform: translateY(-50%);
  border-radius: 0 4rpx 4rpx 0;
}

.icon-battery::after {
  content: '';
  position: absolute;
  width: 60%;
  height: calc(100% - 6rpx);
  background-color: currentColor;
  left: 3rpx;
  top: 50%;
  transform: translateY(-50%);
  border-radius: 2rpx;
}

.icon-success {
  width: 40rpx;
  height: 40rpx;
  border: 4rpx solid var(--success-color);
  border-radius: 50%;
  position: relative;
}

.icon-success::after {
  content: '';
  position: absolute;
  width: 12rpx;
  height: 20rpx;
  border-right: 4rpx solid var(--success-color);
  border-bottom: 4rpx solid var(--success-color);
  top: 50%;
  left: 50%;
  transform: translate(-50%, -60%) rotate(45deg);
}

.icon-fail {
  width: 40rpx;
  height: 40rpx;
  border: 4rpx solid var(--danger-color);
  border-radius: 50%;
  position: relative;
}

.icon-fail::before,
.icon-fail::after {
  content: '';
  position: absolute;
  width: 20rpx;
  height: 4rpx;
  background-color: var(--danger-color);
  top: 50%;
  left: 50%;
}

.icon-fail::before {
  transform: translate(-50%, -50%) rotate(45deg);
}

.icon-fail::after {
  transform: translate(-50%, -50%) rotate(-45deg);
}
