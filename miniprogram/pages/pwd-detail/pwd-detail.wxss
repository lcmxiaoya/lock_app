.page {
  min-height: 100vh;
  background-color: #f5f5f5;
}

/* Navigation Bar */
.nav-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background-color: #fff;
}

.nav-bar-inner {
  display: flex;
  align-items: center;
  padding: 0 30rpx;
}

.nav-left {
  width: 80rpx;
  display: flex;
  align-items: center;
}

.nav-back-arrow {
  width: 20rpx;
  height: 20rpx;
  border-left: 4rpx solid #333;
  border-bottom: 4rpx solid #333;
  transform: rotate(45deg);
}

.nav-title {
  flex: 1;
  text-align: center;
  font-size: 34rpx;
  font-weight: 600;
  color: #333;
}

.nav-right {
  width: 80rpx;
}

/* Detail Card */
.detail-card {
  background-color: #fff;
  margin: 24rpx 0;
  padding: 0 30rpx;
}

.detail-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.detail-row:last-child {
  border-bottom: none;
}

.detail-row-block {
  flex-direction: column;
  align-items: flex-start;
  gap: 12rpx;
}

.detail-label {
  font-size: 30rpx;
  color: #333;
  flex-shrink: 0;
}

.detail-value {
  font-size: 30rpx;
  color: #999;
  text-align: right;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.detail-row-block .detail-value {
  text-align: left;
  white-space: pre-wrap;
  word-break: break-all;
}

.detail-value-wrap {
  display: flex;
  align-items: center;
  flex: 1;
  justify-content: flex-end;
}

.arrow-right {
  width: 14rpx;
  height: 14rpx;
  border-right: 3rpx solid #ccc;
  border-bottom: 3rpx solid #ccc;
  transform: rotate(-45deg);
  margin-left: 12rpx;
  flex-shrink: 0;
}

/* Delete Button */
.delete-section {
  padding: 60rpx 30rpx;
}

.btn-delete {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 96rpx;
  background-color: #fff;
  border-radius: 48rpx;
  font-size: 32rpx;
  color: #333;
  font-weight: 500;
}
