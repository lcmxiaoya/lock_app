.admin-page {
  min-height: 100vh;
  background-color: #f7f7f7;
  padding-bottom: 200rpx;
}

.admin-list {
  padding: 24rpx 24rpx 0;
}

.admin-item {
  display: flex;
  align-items: center;
  background-color: #fff;
  border-radius: 24rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 20rpx;
}

.admin-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background-color: #2979ff;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.avatar-icon {
  font-size: 44rpx;
  color: #fff;
}

.admin-info {
  flex: 1;
  min-width: 0;
}

.admin-name-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 10rpx;
}

.admin-name {
  font-size: 32rpx;
  color: #333;
  font-weight: 500;
}

.admin-status {
  font-size: 24rpx;
}

.admin-status.expired {
  color: #ff5252;
}

.admin-status.valid {
  color: #4caf50;
}

.admin-time {
  font-size: 24rpx;
  color: #999;
}

.empty-state {
  padding: 200rpx 60rpx;
  text-align: center;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 30rpx;
  color: #666;
  margin-bottom: 12rpx;
}

.empty-hint {
  font-size: 24rpx;
  color: #999;
  line-height: 1.6;
}

.bottom-btn-wrap {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
  background-color: #fff;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.04);
}

.add-btn {
  height: 96rpx;
  background-color: #fff;
  border-radius: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #2979ff;
  font-size: 30rpx;
  font-weight: 500;
  border: 2rpx solid #2979ff;
}

.add-btn-icon {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background-color: #2979ff;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  margin-right: 12rpx;
}
