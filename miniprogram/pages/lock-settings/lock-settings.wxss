.container {
  min-height: 100vh;
  background-color: #f5f7fa;
  padding: 0 0 40rpx;
}

.settings-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 0 40rpx;
  background: linear-gradient(180deg, #2979ff 0%, #1565c0 100%);
  color: #fff;
}

.header-icon {
  font-size: 96rpx;
  margin-bottom: 20rpx;
}

.header-name {
  font-size: 36rpx;
  font-weight: 500;
}

.section {
  margin: 30rpx 24rpx 0;
}

.section-title {
  font-size: 26rpx;
  color: #888;
  margin-bottom: 16rpx;
  padding-left: 8rpx;
}

.info-card {
  background-color: #ffffff;
  border-radius: 16rpx;
  overflow: hidden;
}

.info-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 30rpx;
  min-height: 88rpx;
  box-sizing: border-box;
}

.info-row[catchtap] ,
.info-row[bindtap] {
  /* 可点击行无样式变化，避免误以为可点 */
}

.info-label {
  font-size: 30rpx;
  color: #333;
  flex-shrink: 0;
}

.info-value {
  font-size: 28rpx;
  color: #666;
  text-align: right;
  word-break: break-all;
  margin-left: 20rpx;
}

.info-value-mono {
  font-family: monospace;
}

.info-value-warn {
  color: #ff5252;
}

.info-value-muted {
  color: #999;
}

.info-value-wrap {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-left: 20rpx;
  max-width: 70%;
}

.info-value-wrap .info-value {
  margin-left: 0;
}

.copy-tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  font-size: 22rpx;
  color: #2979ff;
  background-color: #e8f0fe;
  border-radius: 24rpx;
  line-height: 1.6;
  flex-shrink: 0;
}

.info-arrow {
  color: #c0c4cc;
  font-size: 32rpx;
  line-height: 1;
}

.info-divider {
  height: 1rpx;
  background-color: #f0f0f0;
  margin: 0 30rpx;
}

.action-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx;
}

.action-row-left {
  display: flex;
  align-items: center;
  flex: 1;
  margin-right: 16rpx;
}

.action-row-icon {
  width: 80rpx;
  height: 80rpx;
  background-color: #e8f0fe;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.action-row-text {
  flex: 1;
  min-width: 0;
}

.action-row-title {
  font-size: 30rpx;
  color: #333;
  margin-bottom: 6rpx;
}

.action-row-desc {
  font-size: 24rpx;
  color: #999;
  line-height: 1.4;
}

.section-hint {
  font-size: 24rpx;
  color: #999;
  padding: 16rpx 8rpx 0;
}

.bottom-spacer {
  height: 60rpx;
}

/* 名称编辑弹窗（复用 lock-control 删除弹窗的样式） */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 9999;
}

.modal-body {
  width: 600rpx;
  background-color: #ffffff;
  border-radius: 24rpx;
  padding: 40rpx;
  position: relative;
  z-index: 10000;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
  text-align: center;
  margin-bottom: 16rpx;
}

.modal-desc {
  font-size: 26rpx;
  color: #888888;
  text-align: center;
  margin-bottom: 30rpx;
}

.modal-input-wrap {
  margin-bottom: 30rpx;
}

.modal-input {
  width: 100%;
  height: 80rpx;
  border: 1rpx solid #dddddd;
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  background-color: #ffffff;
}

.modal-buttons {
  display: flex;
  gap: 20rpx;
}

.modal-btn {
  flex: 1;
  height: 80rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
}

.modal-btn-cancel {
  background-color: #f5f5f5;
  color: #666666;
}

.modal-btn-confirm {
  background-color: #2979ff;
  color: #ffffff;
}

.modal-desc-danger {
  color: #ff4d4f;
}

.modal-btn-danger {
  background-color: #ff4d4f;
  color: #ffffff;
}
