.lock-page {
  min-height: 100vh;
  background-color: var(--bg-color);
  padding-bottom: 120rpx;
}

.page-header {
  position: relative;
  height: 280rpx;
  overflow: hidden;
}

.header-bg {
  position: absolute;
  top: -100rpx;
  left: -50rpx;
  right: -50rpx;
  height: 380rpx;
  background: linear-gradient(135deg, var(--primary-color) 0%, var(--primary-dark) 100%);
  border-radius: 0 0 48rpx 48rpx;
}

.header-content {
  position: relative;
  z-index: 1;
  padding: 80rpx 40rpx 0;
}

.header-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.page-title {
  font-size: 44rpx;
  font-weight: 600;
  color: #FFFFFF;
  margin-bottom: 8rpx;
}

.page-desc {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
}

.header-add-btn {
  width: 64rpx;
  height: 64rpx;
  background: rgba(255, 255, 255, 0.25);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.content-area {
  padding: 0 30rpx;
  margin-top: -20rpx;
  position: relative;
  z-index: 2;
}

.lock-list {
  padding-bottom: 40rpx;
}

.lock-card {
  background-color: var(--card-bg);
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.06);
}

.lock-card-top {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.lock-icon-wrap {
  margin-right: 24rpx;
  flex-shrink: 0;
}

.lock-icon-bg {
  width: 96rpx;
  height: 96rpx;
  background: linear-gradient(135deg, var(--primary-color) 0%, var(--primary-dark) 100%);
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.lock-info {
  flex: 1;
  min-width: 0;
}

.lock-name {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.lock-alias {
  font-size: 24rpx;
  color: var(--text-hint);
}

.lock-status-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.lock-status-dot.online {
  background-color: var(--success-color);
  box-shadow: 0 0 8rpx rgba(76, 175, 80, 0.5);
}

.lock-status-dot.low {
  background-color: var(--warning-color);
  box-shadow: 0 0 8rpx rgba(255, 152, 0, 0.5);
}

.lock-card-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--border-color);
}

.lock-meta {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.meta-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.meta-label {
  font-size: 22rpx;
  color: var(--text-hint);
}

.meta-value {
  font-size: 24rpx;
  color: var(--text-secondary);
}

/* 空状态(已登录但没有锁) */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 160rpx 60rpx;
}

.empty-icon-wrap {
  width: 200rpx;
  height: 200rpx;
  background: linear-gradient(135deg, rgba(74, 144, 226, 0.08) 0%, rgba(74, 144, 226, 0.04) 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 40rpx;
}

.empty-text {
  font-size: 32rpx;
  color: var(--text-secondary);
  margin-bottom: 12rpx;
}

.empty-hint {
  font-size: 26rpx;
  color: var(--text-hint);
}

/* 游客态:未登录时展示功能介绍,提供"自主选择登录"入口 */
.guest-state {
  padding: 40rpx 0 60rpx;
}

.feature-list {
  background-color: var(--card-bg);
  border-radius: 24rpx;
  padding: 8rpx 32rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.06);
}

.feature-item {
  display: flex;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 1rpx solid var(--border-color);
}

.feature-item:last-child {
  border-bottom: none;
}

.feature-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.feature-icon-1 {
  background: linear-gradient(135deg, #e3f2fd 0%, #bbdefb 100%);
}

.feature-icon-2 {
  background: linear-gradient(135deg, #fff3e0 0%, #ffe0b2 100%);
}

.feature-icon-3 {
  background: linear-gradient(135deg, #e8f5e9 0%, #c8e6c9 100%);
}

.feature-icon-4 {
  background: linear-gradient(135deg, #f3e5f5 0%, #e1bee7 100%);
}

.feature-info {
  flex: 1;
  min-width: 0;
}

.feature-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 6rpx;
}

.feature-desc {
  font-size: 24rpx;
  color: var(--text-hint);
  line-height: 1.4;
}

.login-cta {
  margin-top: 48rpx;
  padding: 0 16rpx;
}

.login-cta-btn {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  background: linear-gradient(135deg, var(--primary-color) 0%, var(--primary-dark) 100%);
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 48rpx;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(41, 121, 255, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  /* 兼容 button 元素的内联块默认行为,确保 flex 子元素能正常居中 */
  box-sizing: border-box;
}

.login-cta-btn::after {
  border: none;
}

.login-cta-btn-hover {
  opacity: 0.85;
}

.login-cta-text {
  /* 让 text 元素参与 flex 布局,避免某些机型 button 内 text 偏移 */
  line-height: 1;
}

.login-cta-hint {
  margin-top: 20rpx;
  text-align: center;
  font-size: 24rpx;
  color: var(--text-hint);
}
