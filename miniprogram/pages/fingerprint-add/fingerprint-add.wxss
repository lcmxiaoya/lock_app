.page { min-height: 100vh; background: #f5f5f5; padding-bottom: 200rpx; }
.tab-bar { display: flex; background: #fff; padding: 0 20rpx; border-bottom: 1rpx solid #f0f0f0; }
.tab { flex: 1; text-align: center; padding: 28rpx 0; font-size: 30rpx; color: #666; position: relative; }
.tab.active { color: #2979ff; font-weight: 600; }
.tab.active::after { content: ''; position: absolute; bottom: 0; left: 50%; transform: translateX(-50%); width: 60rpx; height: 4rpx; background: #2979ff; border-radius: 2rpx; }
.tab-disabled { color: #c0c4cc !important; background-color: #f5f5f5 !important; }

.validity-hint {
  font-size: 24rpx;
  color: #ff8800;
  background-color: #fff7e6;
  margin: 16rpx 24rpx 0;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  line-height: 1.5;
}
.form-card { background: #fff; margin-top: 20rpx; padding: 0 30rpx; }
.row { display: flex; align-items: center; padding: 30rpx 0; border-bottom: 1rpx solid #f5f5f5; }
.row:last-child { border-bottom: none; }
.row-wrap { flex-wrap: wrap; }
.label { width: 160rpx; font-size: 30rpx; color: #333; flex-shrink: 0; }
.input { flex: 1; font-size: 30rpx; color: #333; text-align: right; }
.value { flex: 1; font-size: 30rpx; color: #333; text-align: right; }
.value.placeholder { color: #ccc; }
.value.time { flex: none; width: 120rpx; text-align: center; color: #2979ff; font-weight: 500; margin-left: 12rpx; }
.day-list { flex: 1; display: flex; flex-wrap: wrap; gap: 16rpx; justify-content: flex-end; }
.day { width: 80rpx; height: 60rpx; line-height: 60rpx; text-align: center; font-size: 26rpx; color: #666; border: 2rpx solid #ddd; border-radius: 12rpx; }
.day.day-on { background: #2979ff; color: #fff; border-color: #2979ff; }
.form-hint { padding: 20rpx 0 30rpx; font-size: 26rpx; color: #999; }
.warning { margin: 32rpx 30rpx 0; font-size: 26rpx; color: #999; line-height: 1.6; }
.step { margin: 60rpx 30rpx 0; display: flex; flex-direction: column; align-items: center; }
.step-icon { font-size: 96rpx; margin-bottom: 16rpx; animation: pulse 1.4s ease-in-out infinite; }
.step-text { font-size: 30rpx; color: #2979ff; font-weight: 500; }
.step-progress { margin-top: 12rpx; font-size: 40rpx; color: #2979ff; font-weight: 600; }
@keyframes pulse { 0%,100% { transform: scale(1); } 50% { transform: scale(1.15); } }
.action { margin: 60rpx 30rpx 0; height: 96rpx; background: #2979ff; color: #fff; border-radius: 48rpx; display: flex; align-items: center; justify-content: center; font-size: 32rpx; font-weight: 500; }
.action.action-disabled { background: #a5c2ff; }
