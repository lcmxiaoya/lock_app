.register-page {
  min-height: 100vh;
  background-color: var(--bg-color);
}

.page-header {
  position: relative;
  height: 320rpx;
  overflow: hidden;
}

.header-bg {
  position: absolute;
  top: -100rpx;
  left: -50rpx;
  right: -50rpx;
  height: 420rpx;
  background: linear-gradient(135deg, var(--primary-color) 0%, var(--primary-dark) 100%);
  border-radius: 0 0 60rpx 60rpx;
}

.header-content {
  position: relative;
  z-index: 1;
  padding: 100rpx 40rpx 0;
}

.page-title {
  font-size: 44rpx;
  font-weight: 600;
  color: #FFFFFF;
  margin-bottom: 12rpx;
}

.page-desc {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
}

.register-form {
  padding: 0 40rpx;
  margin-top: -40rpx;
  position: relative;
  z-index: 2;
}

.form-card {
  background-color: var(--card-bg);
  border-radius: 24rpx;
  padding: 8rpx 32rpx;
  box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.08);
}

.form-group {
  padding: 20rpx 0;
}

.input-wrap {
  display: flex;
  align-items: center;
}

.input-icon {
  width: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.form-input {
  flex: 1;
  height: 72rpx;
  border: none;
  background: transparent;
  font-size: 30rpx;
  color: var(--text-primary);
  padding: 0;
}

.input-placeholder {
  color: var(--text-hint);
}

.form-divider {
  height: 1rpx;
  background-color: var(--border-color);
}

.code-input {
  flex: 1;
}

.code-btn {
  height: 60rpx;
  padding: 0 28rpx;
  background-color: rgba(74, 144, 226, 0.08);
  color: var(--primary-color);
  border-radius: 30rpx;
  font-size: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-left: 16rpx;
  white-space: nowrap;
}

.code-btn.disabled {
  background-color: rgba(0, 0, 0, 0.04);
  color: var(--text-hint);
}

.register-btn {
  width: 100%;
  height: 96rpx;
  background: linear-gradient(135deg, var(--primary-color) 0%, var(--primary-dark) 100%);
  color: #FFFFFF;
  font-size: 34rpx;
  font-weight: 500;
  border-radius: 48rpx;
  border: none;
  margin-top: 48rpx;
  box-shadow: 0 8rpx 24rpx rgba(74, 144, 226, 0.35);
  display: flex;
  align-items: center;
  justify-content: center;
  letter-spacing: 8rpx;
}

.register-btn::after {
  border: none;
}

.register-btn:active {
  opacity: 0.85;
}

.login-link {
  display: flex;
  justify-content: center;
  align-items: center;
  margin-top: 36rpx;
  padding: 20rpx 0;
}

.link-text {
  font-size: 28rpx;
  color: var(--text-hint);
}

.link-action {
  font-size: 28rpx;
  color: var(--primary-color);
  font-weight: 500;
  margin-left: 8rpx;
}
