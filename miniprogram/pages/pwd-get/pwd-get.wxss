.page {
  min-height: 100vh;
  background-color: #f5f5f5;
}

/* Navigation Bar */
.nav-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background-color: #fff;
}

.nav-bar-inner {
  display: flex;
  align-items: center;
  padding: 0 30rpx;
}

.nav-left {
  width: 80rpx;
  display: flex;
  align-items: center;
}

.nav-back-arrow {
  width: 20rpx;
  height: 20rpx;
  border-left: 4rpx solid #333;
  border-bottom: 4rpx solid #333;
  transform: rotate(45deg);
}

.nav-title {
  flex: 1;
  text-align: center;
  font-size: 34rpx;
  font-weight: 600;
  color: #333;
}

.nav-right {
  width: 80rpx;
}

/* Tab Bar */
.tab-bar {
  display: flex;
  white-space: nowrap;
  background-color: #fff;
  padding: 24rpx 30rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.tab-item {
  display: inline-block;
  padding: 0 30rpx 24rpx;
  font-size: 30rpx;
  color: #666;
  position: relative;
  flex-shrink: 0;
}

.tab-item.active {
  color: #2979ff;
  font-weight: 600;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 48rpx;
  height: 6rpx;
  background-color: #2979ff;
  border-radius: 3rpx;
}

/* Form Card */
.form-card {
  background-color: #fff;
  margin: 24rpx 0 0;
  padding: 0 30rpx;
}

.form-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.form-row:last-child {
  border-bottom: none;
}

.form-label {
  font-size: 30rpx;
  color: #333;
  flex-shrink: 0;
}

.form-value {
  font-size: 30rpx;
  color: #999;
  text-align: right;
  flex: 1;
  margin-left: 40rpx;
}

.form-value:not(.placeholder) {
  color: #333;
}

.form-input {
  flex: 1;
  font-size: 30rpx;
  text-align: right;
  margin-left: 40rpx;
}

.form-switch {
  transform: scale(0.8);
}

/* Description */
.form-desc {
  padding: 24rpx 30rpx;
  font-size: 26rpx;
  color: #999;
  line-height: 1.6;
  white-space: pre-wrap;
}

/* Submit Button */
.btn-wrap {
  padding: 40rpx 30rpx;
}

.btn-submit {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100rpx;
  background-color: #2979ff;
  border-radius: 50rpx;
  color: #fff;
  font-size: 34rpx;
  font-weight: 500;
}

/* Result Card */
.result-card {
  background-color: #fff;
  margin: 0 30rpx 30rpx;
  border-radius: 24rpx;
  padding: 60rpx 30rpx;
  text-align: center;
}

.result-label {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 24rpx;
}

.result-pwd {
  font-size: 72rpx;
  font-weight: 600;
  color: #2979ff;
  letter-spacing: 8rpx;
  margin-bottom: 24rpx;
}

.result-type {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 12rpx;
}

.result-hint {
  font-size: 22rpx;
  color: #ccc;
}
