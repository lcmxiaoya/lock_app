.profile-page {
  min-height: 100vh;
  background-color: #f5f5f5;
  display: flex;
  flex-direction: column;
}

.user-card {
  background: linear-gradient(135deg, #2979ff 0%, #1565c0 100%);
  padding: 60rpx 40rpx;
  text-align: center;
}

.user-avatar {
  margin-bottom: 20rpx;
}

.avatar-icon {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background-color: rgba(255, 255, 255, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 60rpx;
  margin: 0 auto;
}

.user-name {
  font-size: 36rpx;
  font-weight: 600;
  color: #fff;
  margin-bottom: 8rpx;
}

.user-phone {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
}

.menu-list {
  background: #fff;
  margin: 30rpx 30rpx 0;
  border-radius: 24rpx;
  overflow: hidden;
}

.menu-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  font-size: 30rpx;
}

.menu-label {
  color: #333;
}

.menu-value {
  color: #999;
}

.logout-btn {
  margin: 60rpx 30rpx;
  height: 96rpx;
  background: #fff;
  border-radius: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: #ff4d4f;
  font-weight: 500;
  border: 2rpx solid #ff4d4f;
}

.logout-btn:active {
  background: #fff2f0;
}
