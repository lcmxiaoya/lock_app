.profile-page {
  min-height: 100vh;
  background-color: #f5f5f5;
  display: flex;
  flex-direction: column;
  padding-bottom: 120rpx;
}

.user-card {
  background: linear-gradient(135deg, #2979ff 0%, #1565c0 100%);
  padding: 60rpx 40rpx;
  text-align: center;
}

.user-line {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
}

.user-line-icon {
  flex-shrink: 0;
  display: inline-block;
  width: 80rpx;
  height: 80rpx;
}

.user-phone {
  font-size: 30rpx;
  color: rgba(255, 255, 255, 0.95);
  letter-spacing: 1rpx;
  line-height: 1;
}

.user-hint {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
}

.menu-list {
  background: #fff;
  margin: 30rpx 30rpx 0;
  border-radius: 24rpx;
  overflow: hidden;
}

.menu-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  font-size: 30rpx;
}

.menu-label {
  color: #333;
}

.menu-value {
  color: #999;
}

.menu-value-link {
  color: #2979ff;
  font-size: 28rpx;
}

.logout-btn {
  margin: 60rpx 30rpx;
  height: 96rpx;
  background: #fff;
  border-radius: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: #ff4d4f;
  font-weight: 500;
  border: 2rpx solid #ff4d4f;
}

.logout-btn:active {
  background: #fff2f0;
}

/* 未登录态登录卡 */
.login-card {
  background: #fff;
  margin: 30rpx 30rpx 0;
  border-radius: 24rpx;
  padding: 40rpx 30rpx 36rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.login-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: linear-gradient(135deg, #2979ff 0%, #1565c0 100%);
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 44rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  box-sizing: border-box;
}

.login-btn::after {
  border: none;
}

.login-btn-hover {
  opacity: 0.85;
}

.login-btn-text {
  line-height: 1;
}

.login-tip {
  margin-top: 20rpx;
  font-size: 24rpx;
  color: #999;
  text-align: center;
}
