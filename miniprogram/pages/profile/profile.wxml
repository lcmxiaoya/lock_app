<view class="profile-page">
  <view class="user-card">
    <view class="user-avatar">
      <view class="avatar-icon">👤</view>
    </view>
    <view class="user-name">{{userInfo.nickname || userInfo.username || '用户'}}</view>
    <view class="user-phone" wx:if="{{userInfo.username}}">{{userInfo.username}}</view>
  </view>

  <view class="menu-list">
    <view class="menu-item">
      <text class="menu-label">版本</text>
      <text class="menu-value">1.0.0</text>
    </view>
  </view>

  <view class="logout-btn" bindtap="onLogout">
    <text>退出登录</text>
  </view>
</view>
<custom-tab-bar></custom-tab-bar>
