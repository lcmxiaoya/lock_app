<view class="page">
  <view class="list" wx:if="{{cards.length > 0}}">
    <view class="item" wx:for="{{cards}}" wx:key="recordId" bindtap="onCardClick" data-index="{{index}}">
      <view class="avatar">💳</view>
      <view class="info">
        <view class="title-row">
          <text class="title">{{item.cardName || item.cardNumber}}</text>
          <text class="status {{item.expired ? 'expired' : 'valid'}}">{{item.statusText}}</text>
        </view>
        <view class="meta">{{item.rangeText}}</view>
      </view>
    </view>
  </view>

  <view class="empty" wx:elif="{{!loading}}">
    <view class="empty-icon">💳</view>
    <view class="empty-text">暂无 IC 卡</view>
    <view class="empty-hint">请在锁边添加 IC 卡</view>
  </view>

  <view class="bottom-bar">
    <view class="add-btn" bindtap="goAdd">
      <text class="plus">+</text>
      <text>添加 IC 卡</text>
    </view>
  </view>
</view>
