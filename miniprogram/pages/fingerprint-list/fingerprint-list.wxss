.page { min-height: 100vh; background: #f7f7f7; padding-bottom: 200rpx; }
.list { padding: 24rpx; }
.item { background: #fff; border-radius: 24rpx; padding: 28rpx 24rpx; margin-bottom: 20rpx; display: flex; align-items: center; }
.avatar { width: 88rpx; height: 88rpx; border-radius: 50%; background: #2979ff; color: #fff; display: flex; align-items: center; justify-content: center; font-size: 44rpx; margin-right: 24rpx; flex-shrink: 0; }
.info { flex: 1; min-width: 0; }
.title-row { display: flex; align-items: center; gap: 12rpx; margin-bottom: 10rpx; }
.title { font-size: 32rpx; color: #333; font-weight: 500; }
.type-tag { font-size: 20rpx; padding: 2rpx 12rpx; border-radius: 8rpx; background: #fff3e0; color: #ff9800; }
.status { font-size: 24rpx; }
.status.expired { color: #ff5252; }
.status.valid { color: #4caf50; }
.meta { font-size: 24rpx; color: #999; }
.empty { padding: 200rpx 60rpx; text-align: center; }
.empty-icon { font-size: 120rpx; margin-bottom: 24rpx; }
.empty-text { font-size: 30rpx; color: #666; margin-bottom: 12rpx; }
.empty-hint { font-size: 24rpx; color: #999; }
.bottom-bar { position: fixed; bottom: 0; left: 0; right: 0; padding: 24rpx 32rpx calc(24rpx + env(safe-area-inset-bottom)); background: #fff; box-shadow: 0 -4rpx 20rpx rgba(0,0,0,0.04); }
.add-btn { height: 96rpx; border-radius: 48rpx; border: 2rpx solid #2979ff; color: #2979ff; display: flex; align-items: center; justify-content: center; font-size: 30rpx; font-weight: 500; }
.plus { width: 40rpx; height: 40rpx; border-radius: 50%; background: #2979ff; color: #fff; display: flex; align-items: center; justify-content: center; font-size: 32rpx; margin-right: 12rpx; }
