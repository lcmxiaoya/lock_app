<view class="page">
  <view class="list" wx:if="{{fingers.length > 0}}">
    <view class="item" wx:for="{{fingers}}" wx:key="recordId" bindtap="onFingerClick" data-index="{{index}}">
      <view class="avatar">👆</view>
      <view class="info">
        <view class="title-row">
          <text class="title">{{item.fingerprintName || item.fingerprintNumber}}</text>
          <text class="type-tag">{{item.typeText}}</text>
          <text class="status {{item.expired ? 'expired' : 'valid'}}">{{item.statusText}}</text>
        </view>
        <view class="meta">{{item.rangeText}}</view>
      </view>
    </view>
  </view>

  <view class="empty" wx:elif="{{!loading}}">
    <view class="empty-icon">👆</view>
    <view class="empty-text">暂无指纹</view>
    <view class="empty-hint">请在锁边录入指纹</view>
  </view>

  <view class="bottom-bar">
    <view class="add-btn" bindtap="goAdd">
      <text class="plus">+</text>
      <text>添加指纹</text>
    </view>
  </view>
</view>
