.login-page {
  min-height: 100vh;
  box-sizing: border-box;
  background: linear-gradient(142deg, #d9ecff 0%, #eff9fb 28%, #f7f8fb 48%, #ffffff 100%);
  display: flex;
  flex-direction: column;
  align-items: stretch;
  position: relative;
  overflow: hidden;
}

.login-page::before {
  content: '';
  position: absolute;
  top: -220rpx;
  right: -180rpx;
  width: 620rpx;
  height: 620rpx;
  border-radius: 50%;
  background: rgba(206, 248, 242, 0.7);
  filter: blur(20rpx);
}

.login-hero {
  position: relative;
  z-index: 1;
  padding-top: calc(176rpx + env(safe-area-inset-top));
  display: flex;
  flex-direction: column;
  align-items: center;
}

.logo-card {
  width: 132rpx;
  height: 132rpx;
  border-radius: 28rpx;
  background: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 10rpx 32rpx rgba(35, 73, 142, 0.08);
}

.brand-logo {
  width: 86rpx;
  height: 88rpx;
  position: relative;
}

.logo-bar {
  position: absolute;
  top: 4rpx;
  width: 13rpx;
  background: #1f58d6;
  border-radius: 7rpx;
}

.logo-bar-1 {
  left: 0;
  height: 58rpx;
}

.logo-bar-2 {
  left: 22rpx;
  height: 74rpx;
}

.logo-bar-3 {
  left: 44rpx;
  height: 78rpx;
}

.logo-bar-4 {
  left: 66rpx;
  height: 64rpx;
}

.logo-key {
  position: absolute;
  left: 24rpx;
  bottom: 2rpx;
  width: 58rpx;
  height: 44rpx;
  transform: rotate(-42deg);
}

.logo-key-ring {
  position: absolute;
  top: 2rpx;
  right: 0;
  width: 23rpx;
  height: 23rpx;
  border: 8rpx solid #ffffff;
  border-radius: 50%;
}

.logo-key-shaft {
  position: absolute;
  top: 18rpx;
  right: 30rpx;
  width: 32rpx;
  height: 8rpx;
  background: #ffffff;
  border-radius: 4rpx;
}

.logo-key-tooth {
  position: absolute;
  width: 8rpx;
  height: 15rpx;
  background: #ffffff;
  border-radius: 4rpx;
}

.logo-key-tooth-1 {
  top: 23rpx;
  left: 10rpx;
}

.logo-key-tooth-2 {
  top: 23rpx;
  left: 24rpx;
}

.app-title {
  margin-top: 24rpx;
  color: #0f1117;
  font-size: 34rpx;
  line-height: 48rpx;
  font-weight: 700;
  letter-spacing: 6rpx;
}

.login-actions {
  position: relative;
  z-index: 1;
  padding: 0 32rpx;
  margin-top: 100rpx;
}

.phone-login-btn,
.account-login-btn,
.login-btn {
  width: 100%;
  height: 80rpx;
  border-radius: 18rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 700;
  letter-spacing: 8rpx;
  box-sizing: border-box;
}

.phone-login-btn::after,
.account-login-btn::after,
.login-btn::after {
  border: none;
}

.phone-login-btn {
  background: #2453d6;
  color: #ffffff;
  box-shadow: 0 10rpx 22rpx rgba(36, 83, 214, 0.2);
}

.phone-login-btn:active,
.account-login-btn:active,
.login-btn:active {
  opacity: 0.86;
}

.account-login-btn {
  margin-top: 32rpx;
  background: #ffffff;
  color: #70727a;
  border: 1rpx solid #e2e5ec;
  box-shadow: 0 4rpx 14rpx rgba(14, 35, 78, 0.04);
}

.account-login-btn-disabled {
  background: #f5f6f8;
  color: #b1b4bc;
  border-color: #eef0f4;
  box-shadow: none;
}

.account-login-btn-disabled::after {
  border: none;
}

.login-hint {
  margin-top: 18rpx;
  text-align: center;
  color: #b1b4bc;
  font-size: 27rpx;
  line-height: 40rpx;
  letter-spacing: 1rpx;
}

.account-section {
  margin-top: 34rpx;
}

.form-card {
  background-color: #ffffff;
  border-radius: 20rpx;
  padding: 8rpx 28rpx;
  box-shadow: 0 10rpx 34rpx rgba(16, 38, 86, 0.08);
}

.form-group {
  padding: 16rpx 0;
}

.input-wrap {
  display: flex;
  align-items: center;
}

.input-icon {
  width: 58rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.form-input {
  flex: 1;
  height: 78rpx;
  border: none;
  background: transparent;
  font-size: 28rpx;
  color: var(--text-primary);
  padding: 0;
}

.input-placeholder {
  color: #b1b4bc;
}

.form-divider {
  height: 1rpx;
  background-color: #eef0f4;
  margin-left: 58rpx;
}

.login-btn {
  margin-top: 28rpx;
  background: #2453d6;
  color: #ffffff;
  box-shadow: 0 10rpx 22rpx rgba(36, 83, 214, 0.2);
}

.register-link {
  display: flex;
  justify-content: center;
  align-items: center;
  margin-top: 18rpx;
  padding: 18rpx 0;
}

.link-text {
  font-size: 26rpx;
  color: #9da1aa;
}

.link-action {
  font-size: 26rpx;
  color: #2453d6;
  font-weight: 500;
  margin-left: 8rpx;
}

.agreement-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: calc(54rpx + env(safe-area-inset-bottom));
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 28rpx;
  box-sizing: border-box;
  color: #626773;
  font-size: 28rpx;
  line-height: 42rpx;
}

.agreement-checkbox {
  width: 38rpx;
  height: 38rpx;
  border-radius: 50%;
  border: 3rpx solid #2453d6;
  margin-right: 12rpx;
  position: relative;
  flex-shrink: 0;
}

.agreement-checkbox-checked::after {
  content: '';
  position: absolute;
  left: 9rpx;
  top: 4rpx;
  width: 13rpx;
  height: 22rpx;
  border-right: 4rpx solid #2453d6;
  border-bottom: 4rpx solid #2453d6;
  transform: rotate(45deg);
}

.agreement-text {
  color: #626773;
}

.agreement-link {
  color: #1557b5;
  margin-left: 12rpx;
}
