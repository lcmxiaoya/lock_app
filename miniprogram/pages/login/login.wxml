<view class="login-page">
  <view class="login-hero">
    <view class="logo-card">
      <view class="brand-logo">
        <view class="logo-bar logo-bar-1"></view>
        <view class="logo-bar logo-bar-2"></view>
        <view class="logo-bar logo-bar-3"></view>
        <view class="logo-bar logo-bar-4"></view>
        <view class="logo-key">
          <view class="logo-key-ring"></view>
          <view class="logo-key-shaft"></view>
          <view class="logo-key-tooth logo-key-tooth-1"></view>
          <view class="logo-key-tooth logo-key-tooth-2"></view>
        </view>
      </view>
    </view>
    <view class="app-title">星防卫</view>
  </view>

  <view class="login-actions">
    <button class="phone-login-btn"
            open-type="getPhoneNumber"
            bindgetphonenumber="onWxLogin">
      手机号快捷登录
    </button>

    <button class="account-login-btn account-login-btn-disabled"
            disabled
            bindtap="toggleAccountLogin">
      星防卫账号登录
    </button>

    <view class="login-hint">使用微信授权手机号即可快速登录</view>

    <view class="account-section" wx:if="{{showAccountLogin}}">
      <view class="form-card">
        <view class="form-group">
          <view class="input-wrap">
            <view class="input-icon">
              <view class="icon-user" style="color: #999; width: 32rpx; height: 32rpx; border-width: 3rpx;"></view>
            </view>
            <input
              class="form-input"
              placeholder="请输入手机号/邮箱"
              placeholder-class="input-placeholder"
              value="{{username}}"
              bindinput="onUsernameInput"
            />
          </view>
        </view>

        <view class="form-divider"></view>

        <view class="form-group">
          <view class="input-wrap">
            <view class="input-icon">
              <view class="icon-lock" style="color: #999; width: 32rpx; height: 32rpx; border-width: 3rpx;"></view>
            </view>
            <input
              class="form-input"
              type="password"
              placeholder="请输入密码"
              placeholder-class="input-placeholder"
              value="{{password}}"
              bindinput="onPasswordInput"
            />
          </view>
        </view>
      </view>

      <button class="login-btn" bindtap="onLogin">登 录</button>
      <view class="register-link" bindtap="goRegister">
        <text class="link-text">还没有账号？</text>
        <text class="link-action">立即注册</text>
      </view>
    </view>
  </view>

  <view class="agreement-bar">
    <view class="agreement-checkbox {{agreed ? 'agreement-checkbox-checked' : ''}}" bindtap="toggleAgreement"></view>
    <text class="agreement-text">我已阅读并同意</text>
    <text class="agreement-link" bindtap="showPrivacyPolicy">《隐私政策》</text>
    <text class="agreement-link" bindtap="showUserAgreement">《用户协议》</text>
  </view>
</view>